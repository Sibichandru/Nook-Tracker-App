<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <application>
    <!--
      exported="true" is required, not optional: system_server binds this
      service from another process. Binding is gated by the BIND_NOTIFICATION_
      LISTENER_SERVICE permission below (only the system holds it), so exporting
      adds no attack surface. Some OEM ROMs refuse to bind an unexported
      listener even though AOSP tolerates it.
    -->
    <service
      android:name=".NookNotificationListenerService"
      android:exported="true"
      android:label="@string/app_name"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
